{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:prepare": "node -e \"const fs=require('fs'); ['acceptance.db','acceptance.db-shm','acceptance.db-wal'].forEach(f=>{try{fs.rmSync('prisma/'+f,{force:true})}catch{}})\" && set DATABASE_URL=file:./acceptance.db&& prisma db push --skip-generate",
    "test": "npm.cmd run test:prepare && set DATABASE_URL=file:./acceptance.db&& set FILE_STORAGE_ROOT=.acceptance-uploads&& set NODE_ENV=test&& vitest run --no-file-parallelism"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "multer": "2.2.0",
    "pino": "9.6.0",
    "prisma": "6.4.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "2.2.0",
    "@types/node": "22.14.0",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.2.6"
  }
}

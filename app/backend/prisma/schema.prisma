generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Domain values remain Strings so the migration preserves existing data and API contracts.

model Account {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String // ADMIN | CTV
  status             String // ACTIVE | DISABLED
  version            Int       @default(1)
  mustChangePassword Boolean   @default(false)
  displayName        String
  phone              String?
  ctvCode            String?   @unique
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  adminNotes         String?
  joinedAt           DateTime  @default(now())
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  sessions         Session[]
  accountFiles     AccountFile[]
  schedule         Schedule?
  histories        History[]
  reviewedRequests RegistrationRequest[] @relation("ReviewedBy")
  approvedRequests RegistrationRequest[] @relation("ApprovedAccount")

  @@index([status, deletedAt])
}

model Session {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RegistrationRequest {
  id                String    @id @default(cuid())
  email             String
  passwordHash      String?
  displayName       String
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  status            String // PENDING | APPROVED | REJECTED
  rejectionReason   String?
  reviewedById      String?
  approvedAccountId String?
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  updatedAt         DateTime  @updatedAt

  reviewedBy      Account? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedAccount Account? @relation("ApprovedAccount", fields: [approvedAccountId], references: [id])

  files RegistrationRequestFile[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([email])
  @@index([reviewedById, reviewedAt])
}

model FileAsset {
  id           String    @id @default(cuid())
  storageKey   String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String?
  state        String // STAGED | ACTIVE | QUARANTINED | DELETED
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  registrationFiles RegistrationRequestFile[]
  accountFiles      AccountFile[]

  @@index([state, createdAt])
  @@index([sha256])
}

model RegistrationRequestFile {
  requestId String
  fileId    String
  category  String // AVATAR | CCCD_FRONT | CCCD_BACK | CV

  request   RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileAsset FileAsset           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([requestId, fileId])
  @@unique([requestId, category])
}

model AccountFile {
  accountId String
  fileId    String
  category  String // AVATAR | CCCD_FRONT | CCCD_BACK | CV
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([accountId, fileId])
  @@index([accountId, category, deletedAt])
}

model Schedule {
  id        String   @id @default(cuid())
  accountId String   @unique
  roomCode  String   // ROOM_1..4
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shifts  Shift[]

  @@index([accountId])
}

model Shift {
  scheduleId String
  weekday    Int    // 1..5 (Thứ 2..Thứ 6)
  period     String // MORNING | AFTERNOON

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, weekday, period])
  @@index([scheduleId])
}

model History {
  id         String   @id @default(cuid())
  accountId  String
  workDate   DateTime
  period     String   // MORNING | AFTERNOON
  roomCode   String
  status     String   @default("COMPLETED")
  recordedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, workDate, period])
  @@index([accountId, workDate])
  @@index([workDate, period])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CTV
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileState {
  STAGED
  ACTIVE
  QUARANTINED
  DELETED
}

enum FileCategory {
  AVATAR
  CCCD_FRONT
  CCCD_BACK
  CV
}

enum RoomCode {
  ROOM_1
  ROOM_2
  ROOM_3
  ROOM_4
}

enum Period {
  MORNING
  AFTERNOON
}

enum HistoryStatus {
  COMPLETED
  ACTIVE
  DISABLED
}

enum SnapshotRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  MISSED
}

enum RateLimitScope {
  LOGIN_IP
  LOGIN_ACCOUNT
  REGISTRATION_IP
  UPLOAD_ACCOUNT
}

model Account {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  role               Role
  status             AccountStatus
  version            Int           @default(1)
  mustChangePassword Boolean       @default(false)
  displayName        String
  phone              String?
  ctvCode            String?       @unique
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  adminNotes         String?
  joinedAt           DateTime      @default(now())
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  sessions         Session[]
  accountFiles     AccountFile[]
  schedule         Schedule?
  histories        History[]
  historySources   WorkHistorySource[]
  reviewedRequests RegistrationRequest[] @relation("ReviewedBy")
  approvedRequests RegistrationRequest[] @relation("ApprovedAccount")

  @@index([status, deletedAt])
}

model Session {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RegistrationRequest {
  id                String             @id @default(cuid())
  email             String
  passwordHash      String?
  displayName       String
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  status            RegistrationStatus @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  approvedAccountId String?
  submittedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  updatedAt         DateTime           @updatedAt

  reviewedBy      Account? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedAccount Account? @relation("ApprovedAccount", fields: [approvedAccountId], references: [id])

  files RegistrationRequestFile[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([email])
  @@index([reviewedById, reviewedAt])
}

model FileAsset {
  id           String    @id @default(cuid())
  storageKey   String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String?
  state        FileState
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  registrationFiles RegistrationRequestFile[]
  accountFiles      AccountFile[]

  @@index([state, createdAt])
  @@index([sha256])
}

model RegistrationRequestFile {
  requestId String
  fileId    String
  category  FileCategory

  request   RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileAsset FileAsset           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([requestId, fileId])
  @@unique([requestId, category])
}

model AccountFile {
  accountId String
  fileId    String
  category  FileCategory
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([accountId, fileId])
  @@index([accountId, category, deletedAt])
}

model Schedule {
  id        String   @id @default(cuid())
  accountId String   @unique
  roomCode  RoomCode
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shifts  Shift[]

  @@index([accountId])
}

model Shift {
  scheduleId String
  weekday    Int
  period     Period

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, weekday, period])
  @@index([scheduleId])
}

model History {
  id         String        @id @default(cuid())
  accountId  String
  workDate   DateTime
  period     Period
  roomCode   RoomCode
  status     HistoryStatus @default(COMPLETED)
  recordedAt DateTime      @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, workDate, period])
  @@index([accountId, workDate])
  @@index([workDate, period])
}

model SnapshotRun {
  id             String            @id @default(cuid())
  workDate       DateTime          @unique @db.Date
  status         SnapshotRunStatus
  attemptCount   Int               @default(0)
  nextAttemptAt  DateTime?
  leaseToken     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  insertedCount  Int               @default(0)
  errorCode      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, nextAttemptAt])
}

// Singleton cursor. Dates before trackingStartDate are never backfilled automatically.
model WorkHistoryProgress {
  id                String   @id @default("default")
  trackingStartDate DateTime @db.Date
  lastProcessedDate DateTime @db.Date
  updatedAt         DateTime @updatedAt
}

// Database triggers preserve the final schedule/eligibility state of each transaction.
model WorkHistorySource {
  id            BigInt   @id @default(autoincrement())
  accountId     String
  transactionId BigInt
  effectiveAt   DateTime @db.Timestamptz(3)
  eligible      Boolean
  roomCode      String?
  shifts        Json
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, transactionId])
  @@index([accountId, effectiveAt, id])
}

model RateLimitWindow {
  id             String         @id @default(cuid())
  scope          RateLimitScope
  identityDigest String
  windowStart    DateTime
  requestCount   Int            @default(1)
  expiresAt      DateTime

  @@unique([scope, identityDigest, windowStart])
  @@index([expiresAt])
}

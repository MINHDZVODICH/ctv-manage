generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums represented as Strings with constraints in application layer (SQLite has no native enum)

model Account {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  role                String // ADMIN | CTV
  status              String // ACTIVE | DISABLED
  version             Int       @default(1)
  mustChangePassword  Boolean   @default(false)
  displayName         String
  phone               String?
  ctvCode             String?   @unique
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  adminNotes          String?
  joinedAt            DateTime  @default(now())
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  sessions              Session[]
  accountFiles          AccountFile[]
  scheduleRegistrations ScheduleRegistration[]
  shiftAssignments      ShiftAssignment[]
  workHistories         WorkHistory[]
  reviewedRequests      RegistrationRequest[] @relation("ReviewedBy")
  approvedRequests      RegistrationRequest[] @relation("ApprovedAccount")

  @@index([status, deletedAt])
}

model Session {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RegistrationRequest {
  id                 String    @id @default(cuid())
  email              String
  passwordHash       String?
  displayName        String
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  status             String // PENDING | APPROVED | REJECTED
  rejectionReason    String?
  reviewedById       String?
  approvedAccountId  String?
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  updatedAt          DateTime  @updatedAt

  reviewedBy      Account? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedAccount Account? @relation("ApprovedAccount", fields: [approvedAccountId], references: [id])

  files RegistrationRequestFile[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([email])
  @@index([reviewedById, reviewedAt])
}

model FileAsset {
  id           String    @id @default(cuid())
  storageKey   String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String?
  state        String // STAGED | ACTIVE | QUARANTINED | DELETED
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  registrationFiles RegistrationRequestFile[]
  accountFiles      AccountFile[]

  @@index([state, createdAt])
  @@index([sha256])
}

model RegistrationRequestFile {
  requestId String
  fileId    String
  category  String // AVATAR | CCCD_FRONT | CCCD_BACK | CV

  request   RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileAsset FileAsset           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([requestId, fileId])
  @@unique([requestId, category])
}

model AccountFile {
  accountId String
  fileId    String
  category  String // AVATAR | CCCD_FRONT | CCCD_BACK | CV
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([accountId, fileId])
  @@index([accountId, category, deletedAt])
}

model ScheduleRegistration {
  id         String    @id @default(cuid())
  accountId  String
  startDate  DateTime 
  endDate    DateTime 
  timeZone   String    @default("Asia/Bangkok")
  roomCode   String // ROOM_1..4
  version    Int       @default(1)
  status     String // ACTIVE | CANCELLED | EXPIRED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cancelledAt DateTime?

  account     Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patternSlots SchedulePatternSlot[]
  assignments  ShiftAssignment[]

  @@index([accountId, status, startDate, endDate])
}

model SchedulePatternSlot {
  registrationId String
  weekday        Int // 1..5
  period         String // MORNING | AFTERNOON

  registration ScheduleRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@id([registrationId, weekday, period])
}

model Shift {
  id        String   @id @default(cuid())
  workDate  DateTime
  period    String // MORNING | AFTERNOON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]

  @@unique([workDate, period])
}

model ShiftAssignment {
  id               String    @id @default(cuid())
  shiftId          String
  accountId        String
  registrationId   String
  roomCode         String
  status           String // ACTIVE | CANCELLED
  assignedAt       DateTime  @default(now())
  cancelledAt      DateTime?
  cancellationReason String?
  updatedAt        DateTime  @updatedAt

  shift        Shift                @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  registration ScheduleRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([shiftId, accountId])
  @@unique([registrationId, shiftId])
  @@index([accountId, status])
  @@index([registrationId, status])
}

// Immutable daily snapshots of completed CTV work. Weekly schedule changes do not mutate this table.
model WorkHistory {
  id                 String   @id @default(cuid())
  accountId          String
  workDate           DateTime
  period             String // MORNING | AFTERNOON
  roomCode           String
  status             String   @default("COMPLETED") // COMPLETED
  sourceAssignmentId String?  @unique
  recordedAt         DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, workDate, period])
  @@index([accountId, workDate])
  @@index([workDate, period])
}

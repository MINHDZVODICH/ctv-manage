{
  "name": "ctv-manage-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=app/backend",
    "dev:frontend": "npm run dev --workspace=app/frontend",
    "dev:api": "npm run dev --workspace=app/backend",
    "dev:web": "npm run dev --workspace=app/frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "npm run test --workspace=app/backend",
    "test:e2e": "npm run test:e2e --workspace=app/frontend",
    "test:acceptance": "npm run typecheck && npm run build && npm run test:api && npm run test:e2e",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace=app/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=app/backend",
    "prisma:deploy": "npm run prisma:deploy --workspace=app/backend",
    "prisma:seed": "npm run prisma:seed --workspace=app/backend",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate-sqlite": "npm run db:migrate-sqlite --workspace=app/backend",
    "db:summary": "npm run db:summary --workspace=app/backend"
  },
  "devDependencies": {
    "@types/multer": "2.2.0",
    "concurrently": "9.1.2"
  },
  "dependencies": {
    "multer": "2.2.0"
  }
}
